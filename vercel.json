{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/wall",
      "destination": "/api/wall"
    },
    {
      "source": "/((?!api/|marks/|wall).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/morning",
      "schedule": "*/15 * * * *"
    }
  ]
}
